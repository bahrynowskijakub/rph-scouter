# Copy to .env and adjust. The whole file is optional — every value has a dev default.

PORT=4000
NODE_ENV=development

# ── The front door ────────────────────────────────────────────────────────────────────
# One shared password for the whole app, handed to the people who should see the list. Every
# /api route except /api/health and /api/access/* is closed until a browser has answered it,
# and a browser that has is not asked again for ACCESS_TTL_DAYS.
#
# Generate the hash and paste the line it prints:
#
#   yarn hash-password
#
# Only the hash goes here. The plaintext is what you send people; it is never stored, and a
# hash cannot be turned back into it.
# ACCESS_PASSWORD_HASH='$2b$10$...'
#
# Apostrophes are for the shell, not for dotenv — dotenv keeps the `$` either way, but
# `export ACCESS_PASSWORD_HASH=$2b$10$…` without them expands into fragments. The unquoted-`#`
# trap the admin password warns about cannot bite here: a bcrypt hash is only [./A-Za-z0-9].
#
# Unset in development means no gate at all — `yarn dev` stays as it was. In production the
# backend refuses to serve anything without it, on purpose: a missing variable must not
# quietly publish the roster. Set it in Vercel for Production *and* Preview.
#
# Plaintext shortcut for local work only; the hash wins if both are set, and production
# refuses the plaintext outright (`plaintext_password`).
# ACCESS_PASSWORD="haslo-na-testy"
#
# How long a phone stays let in. 180 days by default — being asked twice is the failure.
# ACCESS_TTL_DAYS=180

# The one admin account, on top of the shared password above. Anyone who knows it can
# configure the event.
# Quote the password. dotenv reads an unquoted `#` as the start of a comment, so
# ADMIN_PASSWORD=secret#1 silently reaches the backend as "secret" and every login fails
# with no hint as to why.
ADMIN_USERNAME=admin
ADMIN_PASSWORD="change-me-before-the-tournament"

# Signs both cookies — the gate's pass and the admin session. Any long random string;
# `openssl rand -hex 32` is the one to use. This is what makes a pass unforgeable, so in
# production the default below is refused and the gate stays shut (`insecure_secret`).
JWT_SECRET=generate-a-long-random-string-here
JWT_TTL=30d

# The database. libSQL, which is SQLite — locally a plain file, in production Turso.
#   local:  file:./backend/data/scouter.db   (the default; no token needed)
#   Turso:  libsql://<baza>-<org>.turso.io   + DB_AUTH_TOKEN
# Run `yarn db:migrate` once against whichever one you point at.
# DB_URL=libsql://rph-scouter-twojaorg.turso.io
# DB_AUTH_TOKEN=

# Comma-separated list of allowed browser origins. On Vercel the SPA and the API share one
# origin, so this only matters for local dev, where Vite serves the front on another port.
CORS_ORIGIN=http://localhost:5173

# Event shown before an admin picks one (Quest Tour #6).
DEFAULT_EVENT_ID=767473

# Roster cache freshness in ms (upstream is only re-fetched after this).
ROSTER_TTL_MS=300000
