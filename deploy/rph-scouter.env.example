# Skopiuj do /etc/rph-scouter.env, wypełnij, potem:
#   sudo chown root:rph /etc/rph-scouter.env && sudo chmod 640 /etc/rph-scouter.env
#
# To NIE jest plik dotenv, tylko EnvironmentFile systemd. Różnice, które potrafią zaboleć:
#   - żadnego `export`,
#   - `#` zaczyna komentarz tak samo jak w dotenv, więc hasło z hashem MUSI być
#     w cudzysłowie (README ostrzega o tym dla .env — tu obowiązuje to samo),
#   - po każdej zmianie tego pliku trzeba `systemctl restart rph-scouter`;
#     systemd czyta go tylko przy starcie usługi.

NODE_ENV=production
PORT=4000

# Poza repo, żeby deploy nigdy nie stanął nad bazą, i w katalogu, który
# StateDirectory= w unicie tworzy jako jedyne zapisywalne miejsce dla tej usługi.
DB_PATH=/var/lib/rph-scouter/scouter.db

# Jedno konto. Kto zna hasło, konfiguruje turniej.
ADMIN_USERNAME=admin
ADMIN_PASSWORD="wstaw-tutaj-swoje-haslo"

# openssl rand -hex 32
JWT_SECRET=
JWT_TTL=30d

# Przy jednym origin przeglądarka nigdy nie robi zapytania cross-origin, więc ta lista
# nic nie przepuszcza ani nie blokuje w normalnej pracy. Ustaw ją zgodnie z prawdą, żeby
# domyślne http://localhost:5173 nie zostało w produkcji jako jedyny wpis.
CORS_ORIGIN=https://rph-scouter.example.com

# Wydarzenie pokazywane, dopóki admin nie ustawi innego (Quest Tour #6).
DEFAULT_EVENT_ID=767473

ROSTER_TTL_MS=300000
