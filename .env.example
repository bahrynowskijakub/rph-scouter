# Copy to .env and adjust. The whole file is optional — every value has a dev default.

PORT=4000
NODE_ENV=development

# The one admin account. Anyone who knows this can configure the event.
# Quote the password. dotenv reads an unquoted `#` as the start of a comment, so
# ADMIN_PASSWORD=secret#1 silently reaches the backend as "secret" and every login fails
# with no hint as to why.
ADMIN_USERNAME=admin
ADMIN_PASSWORD="change-me-before-the-tournament"

# Sign the admin session cookie. Any long random string.
JWT_SECRET=generate-a-long-random-string-here
JWT_TTL=30d

# The database. libSQL, which is SQLite — locally a plain file, in production Turso.
#   local:  file:./backend/data/scouter.db   (the default; no token needed)
#   Turso:  libsql://<baza>-<org>.turso.io   + DB_AUTH_TOKEN
# Run `yarn db:migrate` once against whichever one you point at.
# DB_URL=libsql://rph-scouter-twojaorg.turso.io
# DB_AUTH_TOKEN=

# Comma-separated list of allowed browser origins. On Vercel the SPA and the API share one
# origin, so this only matters for local dev, where Vite serves the front on another port.
CORS_ORIGIN=http://localhost:5173

# Event shown before an admin picks one (Quest Tour #6).
DEFAULT_EVENT_ID=767473

# Roster cache freshness in ms (upstream is only re-fetched after this).
ROSTER_TTL_MS=300000
